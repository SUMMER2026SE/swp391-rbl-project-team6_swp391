# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DATABASE_USERNAME=your-database-username
DATABASE_PASSWORD=your-database-password

# SMTP / Email Configuration
SPRING_MAIL_USERNAME=your-gmail-address@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# Supabase Integration
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq API Keys (use comma-separated list for fallbacks)
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_API_KEY=gsk_key1

# Gemini / Google AI Studio API Keys (use comma-separated list for fallbacks)
GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEY=key1

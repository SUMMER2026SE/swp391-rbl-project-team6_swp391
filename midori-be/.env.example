# ============================================================
# MIDORI Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# DATABASE (PostgreSQL via Supabase)
# ------------------------------------------------------------
# Connection URL for the PostgreSQL database.
# Format: jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=

# Database username (found in Supabase Dashboard > Project Settings > Database)
DATABASE_USERNAME=

# Database password (user password set in Supabase > Authentication > Users)
DATABASE_PASSWORD=

# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------
# Secret key used to sign JWT tokens. Must be at least 32 characters long.
# Generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=

# ------------------------------------------------------------
# GOOGLE OAUTH 2.0
# ------------------------------------------------------------
# Google Cloud Console Client ID for OAuth login.
# Format: <CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# EMAIL / SMTP (Gmail)
# ------------------------------------------------------------
# Gmail address used as the sender for transactional emails.
# Must match the account used to generate the App Password below.
SPRING_MAIL_USERNAME=

# Gmail App Password — 16-character token generated from:
#   Google Account > Security > 2-Step Verification > App passwords
SPRING_MAIL_PASSWORD=

# Sender address used in the "from" field of outbound emails.
APP_MAIL_FROM=

# ------------------------------------------------------------
# ADMIN BOOTSTRAP
# ------------------------------------------------------------
# Default admin account email. Created automatically on first startup
# when app.admin.bootstrap-enabled=true.
ADMIN_BOOTSTRAP_EMAIL=admin@midori.local

# Default admin account password. Set only on first bootstrap.
# Leave empty to disable admin bootstrap.
ADMIN_BOOTSTRAP_PASSWORD=

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
# Supabase project URL (e.g., https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase Service Role Key (anon/public key is safe for client-side;
# service_role key bypasses RLS — keep this secret).
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for audio files (listening exercises).
SUPABASE_STORAGE_BUCKET=listening-audios

# Storage bucket name for video files (shadowing exercises).
SUPABASE_VIDEOS_BUCKET=shadowing-videos

# ------------------------------------------------------------
# REDIS (Optional — defaults to localhost)
# ------------------------------------------------------------
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ------------------------------------------------------------
# GEMINI (Google AI)
# ------------------------------------------------------------
# Single Gemini API key.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated list of multiple Gemini API keys for automatic
# fallback when one key hits rate limits or quota.
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=

# Primary Gemini model name (overrides the default).
# Example: gemini-2.0-flash, gemini-1.5-pro, gemini-3.5-flash
GEMINI_MODEL=gemini-flash-latest

# Comma-separated list of fallback model names, tried in order
# when the primary model returns 404/429/500/503.
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.0-flash-lite

# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------
# OpenAI API key for GPT-based AI features.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------
# DEEPSEEK
# ------------------------------------------------------------
# DeepSeek API key for DeepSeek-based AI features.
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ------------------------------------------------------------
# OPENROUTER
# ------------------------------------------------------------
# OpenRouter API key for routing through multiple AI providers.
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Comma-separated list of multiple OpenRouter API keys for fallback.
OPENROUTER_API_KEYS=

# Primary model for OpenRouter.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Comma-separated list of fallback models for OpenRouter.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free

# Custom referer header value sent with OpenRouter requests.
AI_OPENROUTER_REFERER=http://localhost:8081

# ------------------------------------------------------------
# GROQ (Speech-to-Text for Shadowing)
# ------------------------------------------------------------
# Comma-separated list of Groq API keys for Whisper-based
# speech recognition in the shadowing feature.
# Get from: https://console.groq.com/keys
GROQ_API_KEYS=

# Single Groq API key (fallback when GROQ_API_KEYS not set).
GROQ_API_KEY=

# ------------------------------------------------------------
# SHADOWING / SPEECH
# ------------------------------------------------------------
# Speech provider: groq (recommended) or openai
SHADOWING_SPEECH_PROVIDER=groq

# Speech recognition model profile: fast, balanced, or accurate
SHADOWING_SPEECH_PROFILE=balanced

# API timeout in seconds for speech-to-text calls.
SHADOWING_SPEECH_API_TIMEOUT_SECONDS=120

# Individual model names per profile.
SHADOWING_SPEECH_MODEL_FAST=whisper-large-v3-turbo
SHADOWING_SPEECH_MODEL_BALANCED=whisper-large-v3
SHADOWING_SPEECH_MODEL_ACCURATE=whisper-large-v3

# Minimum similarity score (0.0-1.0) for speech evaluation to pass.
SHADOWING_SIMILARITY_THRESHOLD=0.80

# Gemini score threshold (0-100) for shadowing pronunciation evaluation.
SHADOWING_GEMINI_THRESHOLD=80

# Maximum recording duration in seconds for shadowing submissions.
SHADOWING_MAX_RECORDING_SECONDS=15

# Gemini model used for shadowing pronunciation evaluation.
SHADOWING_GEMINI_MODEL=gemini-2.0-flash

# API timeout in seconds for shadowing evaluation calls.
SHADOWING_API_TIMEOUT_SECONDS=120

# Cache TTL in minutes for shadowing evaluation results.
SHADOWING_CACHE_TTL_MINUTES=60

# Maximum number of shadowing evaluation results to cache.
SHADOWING_CACHE_MAX_SIZE=10000

# ------------------------------------------------------------
# FFMPEG (Optional — leave empty to use system PATH)
# ------------------------------------------------------------
# Path to the ffmpeg binary.
# Example: /usr/local/bin/ffmpeg or C:\\ffmpeg\\bin\\ffmpeg.exe
FFMPEG_PATH=

# Path to the ffprobe binary (for extracting audio metadata).
FFPROBE_PATH=

# ------------------------------------------------------------
# KANJIDIC2 (Optional — defaults to src/main/resources/dictionary/KANJIDIC2.xml)
# ------------------------------------------------------------
# Path to the KANJIDIC2.xml dictionary file.
# If not set, the application looks in src/main/resources/dictionary/KANJIDIC2.xml
# Download from: https://www.edrdg.org/wiki/index.php/KANJIDIC2
# Or use the download script: .\scripts\download-kanjidic.ps1
KANJIDIC2_PATH=

# ------------------------------------------------------------
# AI EXECUTOR (Thread pool for async AI tasks)
# ------------------------------------------------------------
AI_EXECUTOR_CORE_POOL_SIZE=1
AI_EXECUTOR_MAX_POOL_SIZE=1
AI_EXECUTOR_QUEUE_CAPACITY=100

# ------------------------------------------------------------
# AI GENERAL
# ------------------------------------------------------------
# Default AI provider: gemini, openai, deepseek, or openrouter
AI_PROVIDER=gemini

# Ordered list of providers to try in sequence (comma-separated).
AI_PROVIDER_ORDER=gemini,openrouter

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Server Port
VITE_SERVER_PORT=8081

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Supabase Storage (for avatar and certificate upload)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PASTE_SUPABASE_PUBLISHABLE_KEY_HERE
VITE_SUPABASE_AVATAR_BUCKET=avatars
# Certificate bucket (create "teacher-certificates" bucket in Supabase Storage)
VITE_SUPABASE_CERT_BUCKET=teacher-certificates
